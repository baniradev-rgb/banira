  "templates": {
    "subject": "We got your request — {{business_name}}",
    "ack": "Hi {{first_name}},\n\nThanks for contacting {{business_name}} about {{service}}. Your request is with our team and we'll reply {{response_window}}.\n\nIf you'd like to pick a time now, you can book here: {{booking_url}}\n\n{{signature}}",
    "ack_after_hours": "Hi {{first_name}},\n\nThanks for contacting {{business_name}} about {{service}}. We're closed right now, but your request is first in line when we open, and we'll reply {{response_window}} of opening.\n\n{{signature}}",
    "ack_urgent": "Hi {{first_name}},\n\nWe've received your message and flagged it as urgent. For the fastest response, please call us now at {{phone}}. Otherwise we'll contact you as soon as possible.\n\nIf anyone is in danger, call 911 first.\n\n{{signature}}",
    "followup_1": "Hi {{first_name}},\n\nJust checking you saw our reply about {{service}}. If it's still needed, simply reply to this email and we'll take it from there.\n\n{{signature}}",
    "followup_2": "Hi {{first_name}},\n\nFollowing up once more in case the timing wasn't right. We're happy to answer any questions before you decide.\n\n{{signature}}",
    "followup_3": "Hi {{first_name}},\n\nThis is our last note so we don't fill your inbox. If you still need help with {{service}}, reply any time.\n\n{{signature}}",
    "footer": "Reply \"stop\" and we won't send further follow-ups."
  }
}
