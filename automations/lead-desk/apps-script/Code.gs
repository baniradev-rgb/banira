/**
 * Banira Lead Desk — Google Apps Script adapter (v1.1.0)
 *
 * Runs inside the CLIENT'S OWN Google account (Gmail + Sheets). No paid services.
 * Files in this Apps Script project:
 *   Engine.gs  — exact copy of src/engine.js (generated by tools/build_apps_script.js)
 *   Config.gs  — CLIENT_CONFIG object (generated from onboarding intake)
 *   Code.gs    — this file: Sheets/Gmail I/O, triggers, logging, safeguards
 *
 * Entry points
 *   setup()            run once by the installer: creates sheets + triggers, validates config
 *   onFormSubmit(e)    trigger from a linked Google Form
 *   doPost(e)          web-app endpoint for an existing website form (JSON or form-encoded).
 *                      Always answers JSON: {ok:true,id} once the inquiry is recorded, or {ok:false,error,retry}.
 *   runFollowUps()     hourly time trigger: detect replies, send due follow-ups
 *   dailyDigest()      daily time trigger: summary email to the owner
 *
 * Safeguards (each has a test in tests/apps_script.test.js)
 *   - Recorded first: the row is written before any email, so a failed send never loses an inquiry.
 *   - Bot filters: honeypot field, minimum fill time (config.min_form_seconds, from the form's started_at),
 *     link-spam scoring (engine), optional Cloudflare Turnstile verified server-side (secret in Script
 *     Properties TURNSTILE_SECRET, never in the web page).
 *   - Duplicate protection: same person + same message within 24 h → one record, one reply.
 *   - Send limits: one automatic reply per address per 24 h, hourly and daily caps (config.limits),
 *     and a quota reserve so owner alerts still go out. Held replies are flagged to the owner.
 *   - Spreadsheet-safe text: visitor text that starts with = + - @ is stored as plain text.
 *   - No double follow-ups: a script lock prevents overlapping runs; each follow-up is marked before and after
 *     sending. A send interrupted between the two is flagged "needs-attention", never retried automatically.
 *   - Failures are visible: a failed reply marks the lead "needs-attention" and the owner alert says so.
 *   - Honest test mode: DRY_RUN=true records what would be sent, sends nothing, uses up no follow-ups.
 *
 * Install in the business mailbox that should SEND replies (lead replies then land in the
 * same Gmail thread, which is how replies are detected). Alerts go to business.owner_email.
 */

var ADAPTER_VERSION = '1.1.0';
var LEADS_SHEET = 'Leads';
var LOG_SHEET = 'Log';
var HEADERS = ['Lead ID', 'Received', 'Name', 'Email', 'Phone', 'ZIP', 'Service', 'Message', 'Score', 'Tier',
  'Urgent', 'Status', 'Auto-reply', 'Follow-ups sent', 'Last follow-up', 'Last reply', 'Thread ID', 'Notes', 'Score reasons',
  'Dedupe key', 'Send state', 'Source'];
var COL = {};
HEADERS.forEach(function (h, i) { COL[h] = i + 1; });
var DAY = 86400000, HOUR = 3600000;
var INTERRUPTED_AFTER_MS = 10 * 60000;

function cfg_() { return CLIENT_CONFIG; }
function props_() { return PropertiesService.getScriptProperties(); }
function dryRun_() { return props_().getProperty('DRY_RUN') === 'true'; }

function ss_() {
  var id = props_().getProperty('SPREADSHEET_ID');
  return id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
}

function sheet_(name, headers) {
  var ss = ss_();
  var sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.appendRow(headers);
    sh.setFrozenRows(1);
  }
  return sh;
}

/** Log sheet records events and IDs, never message contents. */
function log_(level, event, detail) {
  try {
    sheet_(LOG_SHEET, ['Time', 'Level', 'Event', 'Detail']).appendRow([new Date(), level, event, String(detail || '').slice(0, 2000)]);
  } catch (e) { console.error('log failed', e); }
  if (level === 'ERROR') notifyError_(event);
}

/** At most one error email per hour, so a broken trigger can't flood the owner. Contains no customer details. */
function notifyError_(event) {
  var props = props_();
  var last = Number(props.getProperty('LAST_ERROR_EMAIL') || 0);
  if (Date.now() - last < HOUR) return;
  props.setProperty('LAST_ERROR_EMAIL', String(Date.now()));
  try {
    MailApp.sendEmail(cfg_().business.owner_email, '[Lead Desk] Error: ' + event,
      'Banira Lead Desk hit an error and may need attention.\n\nEvent: ' + event + '\n\nSee the Log sheet for details. No customer details are included in this email.');
  } catch (e) { console.error(e); }
}

function setup() {
  var problems = LeadEngine.checkConfig(cfg_());
  if (problems.length) throw new Error('Config problems:\n- ' + problems.join('\n- '));
  if (cfg_().bot_check === 'turnstile' && !props_().getProperty('TURNSTILE_SECRET')) throw new Error('bot_check is "turnstile" but Script Property TURNSTILE_SECRET is not set');
  sheet_(LEADS_SHEET, HEADERS);
  sheet_(LOG_SHEET, ['Time', 'Level', 'Event', 'Detail']);
  ScriptApp.getProjectTriggers().forEach(function (t) { ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('runFollowUps').timeBased().everyHours(1).create();
  ScriptApp.newTrigger('dailyDigest').timeBased().everyDays(1).atHour(7).create();
  var form = props_().getProperty('FORM_ID');
  if (form) ScriptApp.newTrigger('onFormSubmit').forForm(form).onFormSubmit().create();
  log_('INFO', 'setup', 'Engine ' + LeadEngine.VERSION + ' · adapter ' + ADAPTER_VERSION + ' · dryRun=' + dryRun_() + ' · form=' + (form || 'none'));
  return 'OK';
}

/** Google Form trigger. Google Forms has its own bot protection, so the website-only checks are skipped. */
function onFormSubmit(e) {
  var raw = {};
  if (e && e.namedValues) {
    Object.keys(e.namedValues).forEach(function (k) { raw[k] = e.namedValues[k]; });
  } else if (e && e.response) {
    e.response.getItemResponses().forEach(function (r) { raw[r.getItem().getTitle()] = r.getResponse(); });
    raw.email = raw.email || e.response.getRespondentEmail();
  }
  return handleInquiry_(raw, new Date(), { source: 'Google Form' });
}

/** Website form endpoint (deploy as web app, "Anyone"). */
function doPost(e) {
  var raw = {};
  try {
    if (e && e.postData && /json/.test(e.postData.type)) raw = JSON.parse(e.postData.contents);
    else if (e && e.parameter) raw = e.parameter;
  } catch (err) {
    log_('WARN', 'doPost-parse', 'unreadable body');
    return json_({ ok: false, error: 'unreadable', retry: false });
  }
  var res = handleInquiry_(raw, new Date(), { source: 'Website form', web: true });
  if (!res || res.status === 'error') return json_({ ok: false, error: res && res.error || 'server', retry: true });
  if (res.status === 'rejected') return json_({ ok: false, error: res.error, retry: res.retry });
  return json_({ ok: true, id: res.id, duplicate: !!res.duplicate });
}

function json_(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}

/** Bot checks that need the web request: minimum fill time and the optional Turnstile token. */
function botCheck_(raw, now) {
  var min = Number(cfg_().min_form_seconds || 0);
  var started = Number(raw.started_at || 0);
  if (min > 0 && started > 0 && now.getTime() - started < min * 1000) return { bot: true, reason: 'form filled in under ' + min + ' s' };
  if (cfg_().bot_check === 'turnstile') {
    var token = raw['cf-turnstile-response'];
    if (!token) return { reject: 'bot-check-missing' };
    try {
      var r = UrlFetchApp.fetch('https://challenges.cloudflare.com/turnstile/v0/siteverify', {
        method: 'post', muteHttpExceptions: true,
        payload: { secret: props_().getProperty('TURNSTILE_SECRET'), response: String(token).slice(0, 2048) }
      });
      var body = JSON.parse(r.getContentText() || '{}');
      if (!body.success) return { reject: 'bot-check-failed' };
    } catch (err) {
      log_('WARN', 'turnstile-unreachable', String(err));
      return { reject: 'bot-check-unavailable', retry: true };
    }
  }
  return {};
}

/** Recent rows (newest first) for duplicate and send-limit checks; reads only the columns it needs. */
function recentRows_(sh, now, windowMs) {
  var rows = sh.getDataRange().getValues().slice(1);
  var out = [];
  for (var i = rows.length - 1; i >= 0; i--) {
    var t = new Date(rows[i][COL['Received'] - 1]).getTime();
    if (isNaN(t)) continue;
    if (now.getTime() - t > windowMs) continue;
    out.push({ row: rows[i], rowNum: i + 2, at: t });
  }
  return out;
}

function handleInquiry_(raw, now, opts) {
  opts = opts || {};
  var lock = LockService.getScriptLock();
  try { lock.waitLock(20000); } catch (e) { log_('WARN', 'lock-busy', 'inquiry'); return { status: 'error', error: 'busy' }; }
  try {
    var C = cfg_();
    var check = opts.web ? botCheck_(raw, now) : {};
    if (check.reject) { log_('WARN', 'bot-check', check.reject); return { status: 'rejected', error: check.reject, retry: !!check.retry }; }
    var r = LeadEngine.processInquiry(raw, C, now);
    if (check.bot) { r.status = 'spam'; r.reply = null; r.followUps = []; r.reasons = (r.reasons || []).concat(['Bot check: ' + check.reason]); }
    var sh = sheet_(LEADS_SHEET, HEADERS);
    var recent = recentRows_(sh, now, DAY);

    // duplicate: same person + same message within 24 h → keep the first record
    for (var d = 0; d < recent.length; d++) {
      if (recent[d].row[COL['Dedupe key'] - 1] === r.dedupeKey) {
        log_('INFO', 'duplicate', recent[d].row[COL['Lead ID'] - 1]);
        return { status: 'duplicate', duplicate: true, id: recent[d].row[COL['Lead ID'] - 1] };
      }
    }

    var id = 'L' + Utilities.formatDate(now, C.business.timezone, 'yyMMdd-HHmmss') + '-' + Math.floor(Math.random() * 900 + 100);
    var L = r.lead;
    var status = r.status === 'spam' ? 'spam' : (r.status === 'invalid' ? 'needs-attention' : 'new');
    var replyNote = r.replySkipped || (r.status === 'spam' ? 'not sent: spam' : '');
    var held = '';

    // send limits (only when there is a reply to send)
    if (r.reply) {
      var lim = C.limits || {};
      var sentRecently = function (x) { return /^sent/.test(String(x.row[COL['Auto-reply'] - 1])); };
      var decision = LeadEngine.autoReplyDecision({
        limits: lim,
        recentToRecipient: recent.some(function (x) { return sentRecently(x) && String(x.row[COL['Email'] - 1]).toLowerCase() === L.email; }),
        hourCount: recent.filter(function (x) { return sentRecently(x) && now.getTime() - x.at < HOUR; }).length,
        dayCount: recent.filter(sentRecently).length,
        quotaRemaining: quota_()
      });
      if (!decision.allow) { held = decision.reason; replyNote = 'held: ' + held; }
      else replyNote = dryRun_() ? 'DRY RUN: ' + r.reply.template : 'sending: ' + r.reply.template;
    }

    // 1) record first
    var S = LeadEngine.safeCell;
    sh.appendRow([id, now, S(L.name), S(L.email), S(L.phone), S(L.zip), r.service.label, S(L.message),
      r.score, r.tier, r.urgent ? 'YES' : '', status, replyNote, 0, '', '', '', held ? 'Auto-reply held: ' + held : '', (r.reasons || []).join('; '),
      r.dedupeKey, '', opts.source || L.source || '']);
    var rowNum = sh.getDataRange().getValues().length;

    // 2) reply
    var failed = '';
    if (r.reply && !held && !dryRun_()) {
      try {
        GmailApp.sendEmail(r.reply.to, r.reply.subject, r.reply.body, { name: C.business.name });
        sh.getRange(rowNum, COL['Auto-reply']).setValue('sent: ' + r.reply.template);
        sh.getRange(rowNum, COL['Thread ID']).setValue(findThreadId_(r.reply.to, r.reply.subject));
      } catch (err) {
        failed = String(err && err.message || err).slice(0, 200);
        sh.getRange(rowNum, COL['Auto-reply']).setValue('failed');
        sh.getRange(rowNum, COL['Status']).setValue('needs-attention');
        sh.getRange(rowNum, COL['Notes']).setValue('Reply could not be sent: ' + failed);
        log_('ERROR', 'reply-failed', id + ' ' + failed);
      }
    }

    // 3) owner alert (not for spam), capped per hour
    if (status !== 'spam' && r.ownerAlert && alertAllowed_(C, now)) {
      var subject = (failed ? '[NEEDS ATTENTION] ' : held ? '[REPLY HELD] ' : '') + r.ownerAlert.subject;
      var body = r.ownerAlert.body + (failed ? '\n\nThe automatic reply could NOT be sent. Please contact this customer yourself.' : '') +
        (held ? '\n\nThe automatic reply was held (' + held + '). Please contact this customer yourself.' : '');
      if (!dryRun_()) {
        try { MailApp.sendEmail(C.business.owner_email, subject, body); } catch (err) { log_('ERROR', 'alert-failed', id); }
      }
    }
    log_('INFO', 'inquiry', id + ' ' + status + ' ' + r.tier + ' ' + r.score + ' ' + (failed ? 'reply failed' : replyNote));
    return { status: status, id: id, result: r };
  } catch (err) {
    log_('ERROR', 'inquiry-failed', (err && err.stack) || err);
    return { status: 'error', error: 'server' };
  } finally {
    lock.releaseLock();
  }
}

function quota_() {
  try { return MailApp.getRemainingDailyQuota(); } catch (e) { return null; }
}

function alertAllowed_(C, now) {
  var max = (C.limits && C.limits.alerts_per_hour) || 30;
  var props = props_();
  var hourKey = String(Math.floor(now.getTime() / HOUR));
  var stored = String(props.getProperty('ALERT_HOUR') || '').split(':');
  var count = stored[0] === hourKey ? Number(stored[1] || 0) : 0;
  if (count >= max) { log_('WARN', 'alert-cap', 'owner alerts capped at ' + max + '/hour'); return false; }
  props.setProperty('ALERT_HOUR', hourKey + ':' + (count + 1));
  return true;
}

function findThreadId_(to, subject) {
  try {
    var threads = GmailApp.search('to:' + to + ' subject:"' + subject.replace(/"/g, '') + '" newer_than:1d', 0, 1);
    return threads.length ? threads[0].getId() : '';
  } catch (e) { return ''; }
}

/** Returns {repliedAt, text} for the most recent message FROM the lead's exact address in the thread, or null. */
function latestReply_(threadId, email) {
  if (!threadId) return null;
  var thread = GmailApp.getThreadById(threadId);
  if (!thread) return null;
  var msgs = thread.getMessages();
  for (var i = msgs.length - 1; i >= 0; i--) {
    if (!LeadEngine.sameAddress(msgs[i].getFrom(), email)) continue;   // bob@x.com ≠ jimbob@x.com
    var subj = msgs[i].getSubject ? msgs[i].getSubject() : '';
    if (LeadEngine.isAutoReply(subj, msgs[i].getPlainBody())) continue;   // out-of-office is not a reply
    return { repliedAt: msgs[i].getDate(), text: msgs[i].getPlainBody() };
  }
  return null;
}

function runFollowUps() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) { log_('WARN', 'runFollowUps', 'previous run still active; skipped'); return { sent: 0, stopped: 0, errors: 0, skipped: true }; }
  try {
    var now = new Date();
    var C = cfg_();
    var sh = sheet_(LEADS_SHEET, HEADERS);
    var rows = sh.getDataRange().getValues();
    var sent = 0, stopped = 0, errors = 0, flagged = 0;
    for (var i = 1; i < rows.length; i++) {
      var row = rows[i];
      var rowNum = i + 1;
      try {
        var email = String(row[COL['Email'] - 1]).toLowerCase();
        var status = String(row[COL['Status'] - 1]);
        if (!email || status !== 'new' && status !== 'following-up') continue;
        // a send that started but never confirmed: don't guess, ask a person
        var sendState = String(row[COL['Send state'] - 1] || '');
        if (/^sending /.test(sendState)) {
          var startedAt = Number(sendState.split(' ')[2] || 0);
          if (now.getTime() - startedAt > INTERRUPTED_AFTER_MS) {
            sh.getRange(rowNum, COL['Status']).setValue('needs-attention');
            sh.getRange(rowNum, COL['Notes']).setValue('A follow-up send was interrupted; check Gmail before sending anything else.');
            log_('WARN', 'followup-interrupted', row[COL['Lead ID'] - 1]);
            flagged++;
          }
          continue;
        }
        var reply = latestReply_(row[COL['Thread ID'] - 1], email);
        if (reply) {
          var optOut = LeadEngine.isOptOut(reply.text);
          sh.getRange(rowNum, COL['Status']).setValue(optOut ? 'unsubscribed' : 'replied');
          sh.getRange(rowNum, COL['Last reply']).setValue(reply.repliedAt);
          stopped++;
          continue;
        }
        if (!(new Date(row[COL['Received'] - 1]).getTime() > 0)) { log_('WARN', 'followup-bad-date', row[COL['Lead ID'] - 1]); continue; }
        var state = { status: status, tier: row[COL['Tier'] - 1], followupsSent: Number(row[COL['Follow-ups sent'] - 1]) || 0, receivedAt: row[COL['Received'] - 1] };
        var next = LeadEngine.nextFollowUp(state, C, now);
        if (next.action === 'complete') { sh.getRange(rowNum, COL['Status']).setValue('no-response'); continue; }
        if (next.action !== 'send') continue;
        if (dryRun_()) { log_('INFO', 'followup-dry-run', row[COL['Lead ID'] - 1] + ' step ' + next.step); continue; } // honest test mode: uses up nothing
        var lead = { email: email, firstName: LeadEngine.sanitizeName(String(row[COL['Name'] - 1])), name: row[COL['Name'] - 1], serviceLabel: LeadEngine.inSentence(String(row[COL['Service'] - 1])) };
        var msg = LeadEngine.buildFollowUp(lead, C, next.template);
        sh.getRange(rowNum, COL['Send state']).setValue('sending ' + next.step + ' ' + now.getTime());
        var thread = row[COL['Thread ID'] - 1] && GmailApp.getThreadById(row[COL['Thread ID'] - 1]);
        if (thread) thread.reply(msg.body, { name: C.business.name });
        else GmailApp.sendEmail(msg.to, msg.subject, msg.body, { name: C.business.name });
        sh.getRange(rowNum, COL['Follow-ups sent']).setValue(next.step);
        sh.getRange(rowNum, COL['Last follow-up']).setValue(now);
        sh.getRange(rowNum, COL['Status']).setValue('following-up');
        sh.getRange(rowNum, COL['Send state']).setValue('');
        sent++;
      } catch (err) {
        errors++;
        log_('ERROR', 'followup-row-' + rowNum, (err && err.message) || err);
      }
    }
    log_('INFO', 'runFollowUps', 'sent=' + sent + ' stopped=' + stopped + ' flagged=' + flagged + ' errors=' + errors + (dryRun_() ? ' (dry run)' : ''));
    return { sent: sent, stopped: stopped, errors: errors, flagged: flagged };
  } finally {
    lock.releaseLock();
  }
}

function dailyDigest() {
  var rows = sheet_(LEADS_SHEET, HEADERS).getDataRange().getValues().slice(1);
  var since = Date.now() - DAY;
  var st = function (r) { return r[COL['Status'] - 1]; };
  var recent = rows.filter(function (r) { return new Date(r[COL['Received'] - 1]).getTime() >= since && st(r) !== 'spam'; });
  var open = rows.filter(function (r) { return ['new', 'following-up'].indexOf(st(r)) !== -1; });
  var replied = rows.filter(function (r) { return st(r) === 'replied'; });
  var attention = rows.filter(function (r) { return st(r) === 'needs-attention'; });
  var body = ['Lead Desk — last 24 hours', '',
    'New leads: ' + recent.length + ' (hot ' + recent.filter(function (r) { return r[COL['Tier'] - 1] === 'hot'; }).length + ')',
    'Waiting on a reply from you or the lead: ' + open.length,
    'Customers who replied (please follow up personally): ' + replied.length,
    'Needing your attention: ' + attention.length, ''];
  attention.slice(0, 20).forEach(function (r) { body.push('• [needs-attention] ' + r[COL['Name'] - 1] + ' — ' + r[COL['Service'] - 1] + ' — ' + r[COL['Email'] - 1]); });
  replied.slice(0, 20).forEach(function (r) { body.push('• [replied] ' + r[COL['Name'] - 1] + ' — ' + r[COL['Service'] - 1] + ' — ' + r[COL['Email'] - 1]); });
  var q = quota_();
  body.push('', 'Email quota left today: ' + (q === null ? 'unknown' : q), 'Open the sheet: ' + ss_().getUrl());
  if (!dryRun_()) MailApp.sendEmail(cfg_().business.owner_email, '[Lead Desk] Daily summary', body.join('\n'));
  log_('INFO', 'dailyDigest', 'recent=' + recent.length + ' open=' + open.length + ' attention=' + attention.length);
}
