/**
 * Banira Lead Desk — Google Apps Script adapter (v1.0.0)
 *
 * Runs inside the CLIENT'S OWN Google account (Gmail + Sheets). No paid services.
 * Files in this Apps Script project:
 *   Engine.gs  — exact copy of src/engine.js (generated by tools/build_apps_script.js)
 *   Config.gs  — CLIENT_CONFIG object (generated from onboarding intake)
 *   Code.gs    — this file: Sheets/Gmail I/O, triggers, logging
 *
 * Entry points
 *   setup()            run once by the installer: creates sheets + triggers, validates config
 *   onFormSubmit(e)    trigger from a linked Google Form
 *   doPost(e)          web-app endpoint for an existing website form (JSON or form-encoded)
 *   runFollowUps()     hourly time trigger: detect replies, send due follow-ups
 *   dailyDigest()      daily time trigger: summary email to the owner
 *
 * Install in the business mailbox that should SEND replies (lead replies then land in the
 * same Gmail thread, which is how replies are detected). Alerts go to business.owner_email.
 *
 * Human boundaries: the owner reviews every lead; the system only sends the
 * templates approved during onboarding. DRY_RUN=true sends nothing (logs only).
 */

var LEADS_SHEET = 'Leads';
var LOG_SHEET = 'Log';
var HEADERS = ['Lead ID', 'Received', 'Name', 'Email', 'Phone', 'ZIP', 'Service', 'Message', 'Score', 'Tier',
  'Urgent', 'Status', 'Auto-reply', 'Follow-ups sent', 'Last follow-up', 'Last reply', 'Thread ID', 'Notes', 'Score reasons'];
var COL = {};
HEADERS.forEach(function (h, i) { COL[h] = i + 1; });

function cfg_() { return CLIENT_CONFIG; }
function dryRun_() { return PropertiesService.getScriptProperties().getProperty('DRY_RUN') === 'true'; }

function ss_() {
  var id = PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
  return id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
}

function sheet_(name, headers) {
  var ss = ss_();
  var sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.appendRow(headers);
    sh.setFrozenRows(1);
  }
  return sh;
}

function log_(level, event, detail) {
  try {
    sheet_(LOG_SHEET, ['Time', 'Level', 'Event', 'Detail']).appendRow([new Date(), level, event, String(detail || '').slice(0, 2000)]);
  } catch (e) { console.error('log failed', e); }
  if (level === 'ERROR') notifyError_(event, detail);
}

/** At most one error email per hour, so a broken trigger can't flood the owner. */
function notifyError_(event, detail) {
  var props = PropertiesService.getScriptProperties();
  var last = Number(props.getProperty('LAST_ERROR_EMAIL') || 0);
  if (Date.now() - last < 3600000) return;
  props.setProperty('LAST_ERROR_EMAIL', String(Date.now()));
  try {
    MailApp.sendEmail(cfg_().business.owner_email, '[Lead Desk] Error: ' + event,
      'Banira Lead Desk hit an error and may need attention.\n\n' + event + '\n' + detail + '\n\nSee the Log sheet for details.');
  } catch (e) { console.error(e); }
}

function setup() {
  var problems = LeadEngine.checkConfig(cfg_());
  if (problems.length) throw new Error('Config problems:\n- ' + problems.join('\n- '));
  sheet_(LEADS_SHEET, HEADERS);
  sheet_(LOG_SHEET, ['Time', 'Level', 'Event', 'Detail']);
  ScriptApp.getProjectTriggers().forEach(function (t) { ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('runFollowUps').timeBased().everyHours(1).create();
  ScriptApp.newTrigger('dailyDigest').timeBased().everyDays(1).atHour(7).create();
  var form = PropertiesService.getScriptProperties().getProperty('FORM_ID');
  if (form) ScriptApp.newTrigger('onFormSubmit').forForm(form).onFormSubmit().create();
  log_('INFO', 'setup', 'Engine ' + LeadEngine.VERSION + ' · dryRun=' + dryRun_() + ' · form=' + (form || 'none'));
  return 'OK';
}

/** Google Form trigger. */
function onFormSubmit(e) {
  var raw = {};
  if (e && e.namedValues) {
    Object.keys(e.namedValues).forEach(function (k) { raw[k] = e.namedValues[k]; });
  } else if (e && e.response) {
    e.response.getItemResponses().forEach(function (r) { raw[r.getItem().getTitle()] = r.getResponse(); });
    raw.email = raw.email || e.response.getRespondentEmail();
  }
  return handleInquiry_(raw, new Date());
}

/** Website form endpoint (deploy as web app, "Anyone"). */
function doPost(e) {
  var raw = {};
  try {
    if (e && e.postData && /json/.test(e.postData.type)) raw = JSON.parse(e.postData.contents);
    else if (e && e.parameter) raw = e.parameter;
  } catch (err) {
    log_('WARN', 'doPost-parse', err);
  }
  var res = handleInquiry_(raw, new Date());
  return ContentService.createTextOutput(JSON.stringify({ ok: !!res && res.status !== 'error' }))
    .setMimeType(ContentService.MimeType.JSON);
}

function handleInquiry_(raw, now) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var r = LeadEngine.processInquiry(raw, cfg_(), now);
    var id = 'L' + Utilities.formatDate(now, cfg_().business.timezone, 'yyMMdd-HHmmss') + '-' + Math.floor(Math.random() * 900 + 100);
    var threadId = '';
    var replyNote = r.replySkipped || '';
    if (r.reply) {
      if (dryRun_()) {
        replyNote = 'DRY RUN: ' + r.reply.template;
      } else {
        GmailApp.sendEmail(r.reply.to, r.reply.subject, r.reply.body, { name: cfg_().business.name });
        threadId = findThreadId_(r.reply.to, r.reply.subject);
        replyNote = 'sent: ' + r.reply.template;
      }
    }
    var L = r.lead;
    sheet_(LEADS_SHEET, HEADERS).appendRow([id, now, L.name, L.email, L.phone, L.zip, r.service.label, L.message,
      r.score, r.tier, r.urgent ? 'YES' : '', r.status, replyNote, 0, '', '', threadId, '', (r.reasons || []).join('; ')]);
    if (r.status !== 'spam' && r.ownerAlert) {
      if (!dryRun_()) MailApp.sendEmail(cfg_().business.owner_email, r.ownerAlert.subject, r.ownerAlert.body);
    }
    log_('INFO', 'inquiry', id + ' ' + r.status + ' ' + r.tier + ' ' + r.score + ' ' + replyNote);
    return r;
  } catch (err) {
    log_('ERROR', 'inquiry-failed', (err && err.stack) || err);
    return { status: 'error' };
  } finally {
    lock.releaseLock();
  }
}

function findThreadId_(to, subject) {
  try {
    var threads = GmailApp.search('to:' + to + ' subject:"' + subject.replace(/"/g, '') + '" newer_than:1d', 0, 1);
    return threads.length ? threads[0].getId() : '';
  } catch (e) { return ''; }
}

/** Returns {repliedAt, text} for the most recent message from the lead in the thread, or null. */
function latestReply_(threadId, email) {
  if (!threadId) return null;
  var thread = GmailApp.getThreadById(threadId);
  if (!thread) return null;
  var msgs = thread.getMessages();
  for (var i = msgs.length - 1; i >= 0; i--) {
    if (String(msgs[i].getFrom()).toLowerCase().indexOf(email) === -1) continue;
    var subj = msgs[i].getSubject ? msgs[i].getSubject() : '';
    if (LeadEngine.isAutoReply(subj, msgs[i].getPlainBody())) continue;   // out-of-office is not a reply
    return { repliedAt: msgs[i].getDate(), text: msgs[i].getPlainBody() };
  }
  return null;
}

function runFollowUps() {
  var now = new Date();
  var sh = sheet_(LEADS_SHEET, HEADERS);
  var rows = sh.getDataRange().getValues();
  var sent = 0, stopped = 0, errors = 0;
  for (var i = 1; i < rows.length; i++) {
    var row = rows[i];
    var rowNum = i + 1;
    try {
      var email = String(row[COL['Email'] - 1]).toLowerCase();
      var status = String(row[COL['Status'] - 1]);
      if (!email || status !== 'new' && status !== 'following-up') continue;
      var reply = latestReply_(row[COL['Thread ID'] - 1], email);
      if (reply) {
        var optOut = LeadEngine.isOptOut(reply.text);
        sh.getRange(rowNum, COL['Status']).setValue(optOut ? 'unsubscribed' : 'replied');
        sh.getRange(rowNum, COL['Last reply']).setValue(reply.repliedAt);
        stopped++;
        continue;
      }
      var state = { status: status, tier: row[COL['Tier'] - 1], followupsSent: Number(row[COL['Follow-ups sent'] - 1]) || 0, receivedAt: row[COL['Received'] - 1] };
      var next = LeadEngine.nextFollowUp(state, cfg_(), now);
      if (next.action === 'complete') { sh.getRange(rowNum, COL['Status']).setValue('no-response'); continue; }
      if (next.action !== 'send') continue;
      var lead = { email: email, firstName: String(row[COL['Name'] - 1]).split(/\s+/)[0], name: row[COL['Name'] - 1], serviceLabel: String(row[COL['Service'] - 1]).toLowerCase() };
      var msg = LeadEngine.buildFollowUp(lead, cfg_(), next.template);
      if (!dryRun_()) {
        var thread = row[COL['Thread ID'] - 1] && GmailApp.getThreadById(row[COL['Thread ID'] - 1]);
        if (thread) thread.reply(msg.body, { name: cfg_().business.name });
        else GmailApp.sendEmail(msg.to, msg.subject, msg.body, { name: cfg_().business.name });
      }
      sh.getRange(rowNum, COL['Follow-ups sent']).setValue(next.step);
      sh.getRange(rowNum, COL['Last follow-up']).setValue(now);
      sh.getRange(rowNum, COL['Status']).setValue('following-up');
      sent++;
    } catch (err) {
      errors++;
      log_('ERROR', 'followup-row-' + rowNum, (err && err.stack) || err);
    }
  }
  log_('INFO', 'runFollowUps', 'sent=' + sent + ' stopped=' + stopped + ' errors=' + errors + (dryRun_() ? ' (dry run)' : ''));
  return { sent: sent, stopped: stopped, errors: errors };
}

function dailyDigest() {
  var rows = sheet_(LEADS_SHEET, HEADERS).getDataRange().getValues().slice(1);
  var since = Date.now() - 86400000;
  var recent = rows.filter(function (r) { return new Date(r[COL['Received'] - 1]).getTime() >= since; });
  var open = rows.filter(function (r) { return ['new', 'following-up'].indexOf(r[COL['Status'] - 1]) !== -1; });
  var replied = rows.filter(function (r) { return r[COL['Status'] - 1] === 'replied'; });
  var body = ['Lead Desk — last 24 hours', '',
    'New leads: ' + recent.length + ' (hot ' + recent.filter(function (r) { return r[COL['Tier'] - 1] === 'hot'; }).length + ')',
    'Waiting on a reply from you or the lead: ' + open.length,
    'Leads who replied (please follow up personally): ' + replied.length, ''];
  replied.slice(0, 20).forEach(function (r) { body.push('• ' + r[COL['Name'] - 1] + ' — ' + r[COL['Service'] - 1] + ' — ' + r[COL['Email'] - 1]); });
  body.push('', 'Open the sheet: ' + ss_().getUrl());
  if (!dryRun_()) MailApp.sendEmail(cfg_().business.owner_email, '[Lead Desk] Daily summary', body.join('\n'));
  log_('INFO', 'dailyDigest', 'recent=' + recent.length + ' open=' + open.length);
}
